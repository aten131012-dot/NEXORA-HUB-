			capI = capI % #caps + 1
			setfpscap(caps[capI])
			b.Text = "FPS: " .. (caps[capI] >= 999 and "MAX" or tostring(caps[capI]))
		end},
		{"รีเซ็ตตำแหน่ง GUI", "Reset GUI position", function()
