	end)

	local caps = {30, 60, 120, 999}
	local capI = 0
	buttons({
		{"จำกัด FPS", "FPS cap", function(b)
			if not setfpscap then
				toast("เครื่องนี้ไม่รองรับจำกัด FPS", "FPS cap not supported")
